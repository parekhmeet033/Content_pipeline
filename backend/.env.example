NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/contentnova?schema=public"

# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Required for AI content generation/suggestions. Get a key at https://platform.openai.com/api-keys
# (or use an OpenAI-compatible provider like OpenRouter: https://openrouter.ai/keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set to use an OpenAI-compatible provider instead of api.openai.com,
# e.g. https://openrouter.ai/api/v1 (with OPENAI_MODEL like openai/gpt-4o-mini)
OPENAI_BASE_URL=
# Optional per-task model overrides. Each falls back to OPENAI_MODEL when unset, so you
# can point different features at different models WITHOUT a second API key — this only
# needs a new key if you switch to a provider not reachable via OPENAI_BASE_URL/OPENAI_API_KEY.
# With OpenRouter, any model string from https://openrouter.ai/models works with the same key.
OPENAI_MODEL_GENERATE=
OPENAI_MODEL_SUGGESTIONS=
# Optional per-task API key overrides, e.g. if the suggestions model runs on a separate
# account/key. Each falls back to OPENAI_API_KEY when unset.
OPENAI_API_KEY_GENERATE=
OPENAI_API_KEY_SUGGESTIONS=

# Frontend origin allowed to call this API (credentials: true)
CORS_ORIGIN=http://localhost:5173
# Set to true in production (HTTPS-only refresh cookie)
COOKIE_SECURE=false

# Rate limiting for /api/ai/* endpoints to bound OpenAI spend
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
